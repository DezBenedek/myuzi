{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "myuzi",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{ "pattern": "myuzi.uvmr.app", "custom_domain": true }
	],
	"vars": {
		"APP_NAME": "MyÜzi",
		"APP_URL": "https://myuzi.uvmr.app",
		"LIVEKIT_URL": "wss://call.api.dezso.hu",
		"FROM_EMAIL": "myuzi@uvmr.app",
		"SUPERADMIN_EMAILS": "benedek@dezso.hu",
		"STRIPE_PRICE_FAMILY": "price_1U1vXfJTnIjHbpTm33GlkrsC",
		"STRIPE_PRICE_FAMILY_PLUS": "price_1U1vY6JTnIjHbpTmEVzGxpda"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "myuzi",
			"database_id": "7b020f14-2ac6-461f-b7f0-572ec64108dd",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "VOICE",
			"bucket_name": "myuzi-voice"
		},
		{
			"binding": "INVOICES",
			"bucket_name": "myuzi-invoices"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "USER_HUB",
				"class_name": "UserHub"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1_user_hub",
			"new_sqlite_classes": ["UserHub"]
		}
	],
	"send_email": [
		{
			"name": "EMAIL",
			"allowed_sender_addresses": [
				"myuzi@uvmr.app"
			]
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}
